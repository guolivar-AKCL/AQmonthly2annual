# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio and editor files
.Rproj.user/
.claude/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
/*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# Shiny token, see https://shiny.rstudio.com/articles/shinyapps.html
rsconnect/

# macOS desktop services store
.DS_Store

# Secret files
_secret*

# ============================================================================
# Nothing generated by the analysis belongs in the repository. Inputs come from
# the authoritative source (the 2025 trends report data), everything else is
# reproduced by running R/00_config.R -> 01 -> 02 -> 03 and knitting the report.
# Folder README.md files are unaffected by the patterns below.
# ============================================================================

# Compiled documents (knitted reports and anything rendered from them)
*.html
*.pdf
*.docx
*.doc
*.odt
*.tex

# Plots and figures - regenerate with R/03_figures.R
output/plots/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.tiff
*.eps

# Data, raw and processed - obtain the inputs from the trends report source
*.csv
*.tsv
*.RData
*.rda
*.rds
*.Rds
*.xlsx
*.xls
*.nc
*.parquet
*.feather
